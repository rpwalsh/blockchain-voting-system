PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/trustless_voting?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-256-bit-secret-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Cookies (OIDC SSO state/PKCE)
COOKIE_SECRET="change-this-in-production-too"

# Multi-tenant
DEFAULT_ORG_SLUG="public-org"

# GOVERNANCE
GOVERNANCE_APP_URL="http://localhost:5173"

# Optional Proof Pack signing
# PROOF_PACK_SIGNING_PRIVATE_KEY="...base64..."
# PROOF_PACK_SIGNING_PUBLIC_KEY="...base64..."

# Crypto
ELECTION_KEY_SIZE=32
SIGNATURE_KEY_SIZE=64

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# IPFS (optional for MVP)
IPFS_HOST="localhost"
IPFS_PORT=5001
IPFS_PROTOCOL="http"

# Admin
ADMIN_EMAIL="admin@trustlessvoting.com"
ADMIN_PASSWORD="change-this-in-production"

# CORS
CORS_ORIGIN="http://localhost:5173"
