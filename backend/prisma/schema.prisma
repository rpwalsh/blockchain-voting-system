// ENTERPRISE MULTI-TENANT VOTING PLATFORM
// ========================================
// Series A Ready: Corporate, Federal, Municipal, Project Management
// Security Level: Nation-state + Enterprise + Regulatory compliance

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT ARCHITECTURE
// ============================================================================

// Organization: Top-level tenant (government, corporation, NGO)
model Organization {
  id              String   @id @default(uuid())
  name            String   // "US Federal Government", "Acme Corp"
  slug            String   @unique // URL-safe identifier
  type            String   // FEDERAL|STATE|MUNICIPAL|CORPORATE|PROJECT|BOARD
  tier            String   @default("ENTERPRISE") // FREE|STARTER|ENTERPRISE|UNLIMITED
  status          String   @default("ACTIVE") // ACTIVE|SUSPENDED|TRIAL|CANCELLED
  
  // Contact
  primaryContact  String
  email           String
  phone           String?
  website         String?
  
  // Billing
  billingEmail    String?
  subscriptionId  String?
  monthlyVoters   Int      @default(0)
  maxVoters       Int      @default(10000) // Tier limit
  
  // Security
  publicKey       String   // Org-level signing key
  apiKey          String   @unique // API access
  webhookUrl      String?  // Event notifications
  ipWhitelist     String?  // JSON array of allowed IPs
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // Level 12 admin who created it
  
  // Relations
  elections       Election[]
  users           User[]
  auditLogs       AuditLog[]
  securityEvents  SecurityEvent[]
  settings        OrganizationSettings?
  authProviders   OrganizationAuthProvider[]
  members         Member[]
  eligibilityRules EligibilityRule[]
  electorateSnapshots ElectorateSnapshot[]
  
  @@index([slug])
  @@index([type])
  @@index([status])
}

// User: Organization members (election officials, admins, voters)
model User {
  id              String    @id @default(uuid())
  organizationId  String
  
  // Identity
  email           String
  username        String    // Can be duplicate across orgs
  passwordHash    String?   // bcrypt cost 12+ (null for SSO-only users)
  firstName       String?
  lastName        String?
  
  // Role-based access control
  role            String    @default("VIEWER") // SUPER_ADMIN|ORG_ADMIN|ELECTION_OFFICER|AUDITOR|VOTER|VIEWER
  permissions     String?   // JSON array of granular permissions
  
  // Security
  publicKey       String?   // User signing key
  mfaSecret       String?   // TOTP secret (encrypted)
  mfaEnabled      Boolean   @default(false)
  mfaBackupCodes  String?   // Encrypted backup codes
  
  // Session management
  lastLoginAt     DateTime?
  lastLoginIp     String?   // Hashed
  sessionToken    String?   // Current session
  sessionExpiry   DateTime?
  
  // Rate limiting / security
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isActive        Boolean   @default(true)
  
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, email])
  @@index([email])
  @@index([role])
  @@index([isActive])
}

// ============================================================================
// BLOCKCHAIN-VOTING-SYSTEM GOVERNANCE + TENANT CONFIG
// ============================================================================

model OrganizationSettings {
  id                String   @id @default(uuid())
  organizationId    String   @unique

  // Product mode
  mode              String   @default("GOVERNANCE") // GOVERNANCE|ELECTIONS_ONLY|CUSTOM
  tenantMode        String   @default("MULTI") // SINGLE|MULTI

  // Auth
  authMode          String   @default("LOCAL") // LOCAL|OIDC
  requireMfaAdmins  Boolean  @default(false)
  allowSelfJoin     Boolean  @default(false)
  selfJoinDomain    String?  // Optional domain allowlist

  // Branding
  brandName         String?  // Display name override
  brandLogoUrl      String?
  brandPrimaryColor String?  // Hex

  // Compliance posture
  complianceProfile String   @default("GOVERNMENT") // GOVERNMENT|ENTERPRISE|COMMUNITY

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationAuthProvider {
  id              String   @id @default(uuid())
  organizationId  String

  type            String   // OIDC
  name            String   // "Okta", "AzureAD", "Auth0", "Google"
  enabled         Boolean  @default(true)

  // OIDC configuration
  issuerUrl       String
  clientId        String
  clientSecret    String
  redirectUri     String
  scopes          String   @default("openid profile email")

  // Claim mapping
  emailClaim      String?  @default("email")
  subjectClaim    String?  @default("sub")
  rolesClaim      String?  // Optional

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([enabled])
}

model Member {
  id              String   @id @default(uuid())
  organizationId  String

  // Imported roster identifiers
  externalId      String
  email           String?
  displayName     String?

  // Eligibility flags (union-friendly)
  duesCurrent     Boolean  @default(false)
  unit            String?
  worksite        String?
  roles           String?  // JSON array (steward, officer, etc)
  metadata        String?  // JSON

  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotLinks   SnapshotMember[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([duesCurrent])
  @@index([isActive])
}

model EligibilityRule {
  id              String   @id @default(uuid())
  organizationId  String

  name            String
  expression      String   // JSON expression (portable, white-boxable)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots       ElectorateSnapshot[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ElectorateSnapshot {
  id                String   @id @default(uuid())
  organizationId    String
  electionId        String   @unique
  eligibilityRuleId String?

  // Reproducibility
  snapshotHash      String
  memberCount       Int
  reportJson        String

  createdAt         DateTime @default(now())

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  election          Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  eligibilityRule   EligibilityRule? @relation(fields: [eligibilityRuleId], references: [id], onDelete: SetNull)
  members           SnapshotMember[]

  @@index([organizationId])
}

model SnapshotMember {
  snapshotId  String
  memberId    String

  snapshot    ElectorateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([snapshotId, memberId])
  @@index([memberId])
}

// Level 12 Super Admin (YOU - system-wide god mode)
model SuperAdmin {
  id              String    @id @default(uuid())
  username        String    @unique // "admin"
  passwordHash    String    // Ultra-secure
  totpSecret      String    // Mandatory MFA
  
  // Security
  publicKey       String
  lastLoginAt     DateTime?
  lastLoginIp     String?
  sessionToken    String?
  
  // Emergency access log
  accessLog       String?   // JSON array of all actions
  
  createdAt       DateTime  @default(now())
  
  @@index([username])
}

// ============================================================================
// ELECTION SYSTEM (Universal: Federal, Corporate, Project, Board)
// ============================================================================

model Election {
  id              String   @id @default(uuid())
  organizationId  String
  
  // Basic info
  name            String
  description     String?
  type            String   // FEDERAL|STATE|LOCAL|CORPORATE_BOARD|SHAREHOLDER|PROJECT|POLL
  category        String?  // Presidential, Board Election, Feature Vote, etc
  
  // Dates
  startDate       DateTime
  endDate         DateTime
  status          String   @default("DRAFT") // DRAFT|REGISTRATION|VOTING|TALLYING|COMPLETED|CANCELLED|DISPUTED
  
  // Cryptography: encryption keypair (NaCl box) used to encrypt ballots.
  // NOTE: privateKey is stored in plaintext today, not "encrypted with
  // HSM/KMS" as an earlier version of this comment claimed - no HSM/KMS
  // integration exists in this codebase. keyShares (real Shamir K-of-N
  // split, see crypto.splitSecretShamir) is populated as a genuine
  // threshold-recovery safety net, but the decrypt path still reads the
  // plaintext privateKey directly rather than requiring share
  // reconstruction - see docs/cryptography.md and docs/threat-model.md,
  // "Colluding trustees", for the honest status of this gap.
  publicKey       String   // Election public key
  privateKeyHash  String   // Verify without storing plaintext
  privateKey      String
  keyShares       String?  // JSON ThresholdKeyShare[] from splitSecretShamir

  // Signing keypair (Ed25519) for this election's ledger entries and
  // finalization manifest - see docs/protocol.md "Stage: Finalization".
  // Single-key today; M-of-N threshold signing is Milestone 5 scope.
  signingPublicKey  String?
  signingPrivateKey String?

  // Anonymous eligibility (see docs/protocol.md "Stage: Credential
  // issuance" and backend/circuits/eligibility.circom). Root of the live
  // Poseidon Merkle tree of enrolled voters' commitments; voters prove
  // membership without revealing which leaf. Mutable during REGISTRATION
  // (enrollment/revocation append or remove leaves); frozen once VOTING
  // starts - see routes/eligibility.ts.
  eligibilityRoot   String?

  // Threshold homomorphic tally (see docs/protocol.md "Stage: Tally" and
  // crypto/tally.ts). EC ElGamal keypair over secp256k1, distinct from the
  // NaCl box keypair above. Unlike privateKey/keyShares, no plaintext
  // private scalar is ever persisted here - tallyKeyShares (Shamir K-of-N)
  // is the only way to recover it, and only via combining >= K trustees'
  // partial decryptions at tally time.
  tallyPublicKey    String?
  tallyKeyShares    String?  // JSON ThresholdKeyShare[] from splitSecretShamir
  tallyThreshold    Int?     // K in the K-of-N trustee scheme

  // Blockchain anchoring
  merkleRoot      String?
  blockchainTx    String?  // Ethereum/Hyperledger transaction hash
  blockchainBlock Int?     // Block number

  // Multi-party administration (see docs/protocol.md "Stage: Election
  // configuration / certification" and routes/election-approvals.ts).
  // Set only once a quorum-approved CERTIFY action executes - not by any
  // single admin's direct write.
  certifiedAt               DateTime?
  certifiedConfigurationHash String?

  // Configuration
  allowAnonymous  Boolean  @default(true)  // Anonymous voting
  requireId       Boolean  @default(true)  // ID verification
  multipleChoice  Boolean  @default(false) // Allow multiple votes
  ranked          Boolean  @default(false) // Ranked choice voting
  weighted        Boolean  @default(false) // Weighted votes (corporate shares)
  
  // Statistics (cached for performance)
  registrationCount Int @default(0)
  voteCount         Int @default(0)
  
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?  // User ID
  lastMerkleUpdate DateTime?
  
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  electorateSnapshot ElectorateSnapshot?
  candidates      Candidate[]
  voters          Voter[]
  votes           Vote[]
  tallyResults    TallyResult[]
  ledgerEntries   LedgerEntry[]
  challengeNonces ChallengeNonce[]
  finalization    ElectionFinalization?
  eligibilityCommitments EligibilityCommitment[]
  nullifiers      Nullifier[]
  trusteeDecryptionShares TrusteeDecryptionShare[]
  approvals       ElectionApproval[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([startDate, endDate])
}

model Candidate {
  id              String   @id @default(uuid())
  electionId      String
  
  // Info
  name            String
  party           String?
  description     String?  // Platform/biography
  photoUrl        String?
  photoHash       String?  // Integrity check
  
  // For weighted voting (corporate)
  weight          Float    @default(1.0)
  
  // Metadata
  order           Int      @default(0) // Display order
  metadata        String?  // JSON for flexibility
  
  createdAt       DateTime @default(now())
  
  election        Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  votes           Vote[]
  tallyResults    TallyResult[]
  
  @@index([electionId])
  @@index([order])
}

model Voter {
  id                  String    @id @default(uuid())
  electionId          String
  
  // Anonymized identity
  identityHash        String    // PBKDF2 210K iterations
  votingTokenHash     String    @unique // SHA3-256, for fast lookup/uniqueness
  tokenCommitment     String?   // real Poseidon commitment (computeTokenCommitment) - what the token_validity ZK proof is checked against at vote time
  publicKey           String    // Voter's public key
  registrationProof   String    // ZK proof of eligibility
  
  // Voting status
  hasVoted            Boolean   @default(false)
  votedAt             DateTime?
  voteReceiptHash     String?   // Link to vote (still anonymous)
  
  // Audit (no PII)
  registeredAt        DateTime  @default(now())
  lastAccessAt        DateTime?
  accessAttempts      Int       @default(0)
  ipAddressHash       String?
  
  // For corporate/weighted voting
  voteWeight          Float     @default(1.0) // Shares, rank, etc
  
  // Metadata for geographic/demographic data (JSON)
  metadata            String?   // JSON for flexible data storage
  
  election            Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, identityHash])
  @@index([votingTokenHash])
  @@index([electionId, hasVoted])
}

model Vote {
  id                String   @id @default(uuid())
  electionId        String
  candidateId       String
  
  // Encrypted vote
  encryptedVote     String   // NaCl box encrypted
  votingTokenHash   String   // legacy per-voter path; equals eligibilityNullifier on the anonymous path
  voteProof         String   // ZK proof vote is valid
  eligibilityNullifier String? // Nullifier from the anonymous eligibility proof, if cast via that path

  // Homomorphic tally ciphertexts (see crypto/tally.ts): one EC ElGamal
  // encryption of 0/1 per candidate (one-hot), JSON array of
  // {candidateId, c1, c2}. The tally route sums these across all ballots
  // and threshold-decrypts the sum - candidateId above is not the source
  // of truth for a cryptographically certified result once this is set.
  tallyCiphertexts  String?
  
  // Verification
  receiptHash       String   @unique // Voter's receipt
  ledgerEntryHash   String   @unique // Public ledger ID
  merkleRoot        String   // Merkle root at vote time
  merkleProof       String   // JSON proof
  
  // DAG (optional - for advanced conflict resolution)
  dagParents        String?  // JSON array of parent vote IDs
  
  // Blockchain
  blockchainAnchor  String?  // Transaction hash
  
  // Weighted/ranked
  weight            Float    @default(1.0)
  rank              Int?     // For ranked-choice
  
  // Audit
  ledgerTimestamp   DateTime @default(now())
  ipAddressHash     String?
  
  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  
  @@index([electionId])
  @@index([candidateId])
  @@index([receiptHash])
  @@index([ledgerEntryHash])
  @@index([votingTokenHash])
}

model TallyResult {
  id              String   @id @default(uuid())
  electionId      String
  candidateId     String
  
  // Results
  voteCount       Int      // Raw count
  weightedVotes   Float?   // For weighted voting
  percentage      Float?   // Percentage of total
  
  // Cryptographic proof
  proof           String   // ZK proof tally is correct
  merkleRoot      String   // All votes included
  
  // Audit
  timestamp       DateTime @default(now())
  verifiedBy      String?  // User ID who verified
  
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([electionId, candidateId])
  @@index([electionId])
}

// ============================================================================
// IMMUTABLE AUDIT TRAIL (Blockchain-style)
// ============================================================================

model LedgerEntry {
  id                String   @id @default(uuid())
  electionId        String
  
  // Entry type
  entryType         String   // VOTE_CAST|TALLY|STATUS_CHANGE|KEY_CEREMONY|ADMIN_ACTION|REGISTRATION
  
  // Data
  data              String   // JSON blob
  dataHash          String   // domainHash(ELECTION-LEDGER, {electionId, entryType, data, previousEntryHash}) - see crypto/canonical.ts

  // Chaining (blockchain-style)
  previousEntryHash String?  // Hash of previous entry
  signature         String   // Ed25519 signature
  signerPublicKey   String   // Who signed
  
  // Merkle tree
  merkleProof       String?
  
  // Blockchain anchor
  blockchainTx      String?
  blockNumber       Int?
  
  timestamp         DateTime @default(now())
  
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // Blocks concurrent writers from forking the chain (see createLedgerEntry).
  @@unique([electionId, previousEntryHash])
  @@index([electionId])
  @@index([entryType])
  @@index([timestamp])
  @@index([previousEntryHash])
}

// ============================================================================
// BALLOT SUBMISSION PROTOCOL (see docs/protocol.md)
// ============================================================================

// A server-issued freshness challenge, bound into a token-validity ZK proof
// at ballot-submission time (see docs/protocol.md, "Stage: Ballot
// submission"). Consumed (marked used) on first successful use - reused or
// unknown challenges are rejected, which is what makes the bound proof's
// freshness guarantee actually enforced server-side rather than just
// asserted by the proof format.
model ChallengeNonce {
  id         String    @id @default(uuid())
  electionId String
  challenge  String    @unique
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
  @@index([expiresAt])
}

// The signed, immutable finalization manifest for a closed election (see
// docs/protocol.md, "Stage: Finalization"). Verification against a live,
// mutable Election.merkleRoot column is not the same guarantee as
// verification against this: a manifest, once created, is never updated,
// and its manifestHash is signed at creation time.
model ElectionFinalization {
  id                    String   @id @default(uuid())
  electionId            String   @unique

  configurationHash     String
  eligibilityRoot       String
  finalBallotRoot       String
  ledgerRoot             String?
  ballotCount           Int
  finalizationTimestamp DateTime @default(now())

  manifestHash          String
  signature             String
  signerPublicKey       String

  // Real external timestamp anchoring via OpenTimestamps
  // (crypto.submitTimestampAnchor) - see docs/cryptography.md, "On the
  // external timestamp anchor". No financial transaction, wallet, or
  // token is involved. otsProof is the serialized .ots proof file;
  // confirmation is asynchronous (typically hours), so otsConfirmed
  // starts false and is only flipped true once
  // crypto.checkTimestampAnchor() actually observes a completed
  // attestation - never asserted eagerly.
  otsProofBase64        String?
  otsSubmittedAt        DateTime?
  otsConfirmed          Boolean  @default(false)
  otsCheckedAt          DateTime?

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId])
}

// ============================================================================
// ANONYMOUS ELIGIBILITY (see docs/protocol.md "Stage: Credential issuance",
// backend/circuits/eligibility.circom, backend/src/crypto/eligibility.ts)
// ============================================================================

// A leaf in the election's eligibility Merkle tree: Poseidon(secret, salt)
// for a voter enrolled during registration. The secret/salt never touch
// the server - only the commitment does. Membership is proven anonymously
// at vote time via eligibility.circom; revoked leaves are excluded from
// tree reconstruction (see routes/eligibility.ts).
model EligibilityCommitment {
  id         String    @id @default(uuid())
  electionId String
  leafIndex  Int
  commitment String    // Poseidon(secret, salt), decimal field element as string
  revoked    Boolean   @default(false)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, commitment])
  @@unique([electionId, leafIndex])
  @@index([electionId, revoked])
}

// A spent eligibility-proof nullifier (Poseidon(secret, electionId)).
// Recording this - not any per-voter row - is what enforces one vote per
// enrolled credential per election without the server ever learning which
// enrolled voter cast which ballot.
model Nullifier {
  id         String   @id @default(uuid())
  electionId String
  nullifier  String
  createdAt  DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, nullifier])
  @@index([electionId])
}

// ============================================================================
// CRYPTOGRAPHIC TALLY (see docs/protocol.md "Stage: Tally",
// backend/src/crypto/tally.ts)
// ============================================================================

// One trustee's partial decryption of a candidate's homomorphically-summed
// EC ElGamal ciphertext, plus a Chaum-Pedersen NIZK proof that the partial
// decryption was computed correctly from that trustee's Shamir share -
// anyone can verify the proof without learning the share or the tally
// before enough trustees have contributed.
model TrusteeDecryptionShare {
  id                 String   @id @default(uuid())
  electionId         String
  candidateId        String
  trusteeIndex       Int      // x-coordinate of this trustee's Shamir share
  partialDecryption  String   // EC point (compressed hex)
  proofCommitmentA   String   // Chaum-Pedersen proof component
  proofCommitmentB   String
  proofResponse      String
  submittedAt        DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@unique([electionId, candidateId, trusteeIndex])
  @@index([electionId])
}

// ============================================================================
// MULTI-PARTY ADMINISTRATION (Milestone 5, see docs/trust-model.md
// "Election administrator" row and routes/election-approvals.ts)
// ============================================================================

// A proposed critical election lifecycle transition (CERTIFY, OPEN_VOTING,
// FINALIZE, CANCEL) that requires signed sign-off from `threshold` distinct
// org admins/officers before it executes - closes the "a compromised
// ORG_ADMIN session can perform any administrative action unilaterally" gap
// docs/trust-model.md calls out. The action only actually runs (status flips
// to EXECUTED and the underlying election mutation happens) once enough
// ElectionApprovalSignature rows exist; a proposal with too few approvals
// stays PENDING forever and has no effect.
model ElectionApproval {
  id           String   @id @default(uuid())
  electionId   String

  action       String   // CERTIFY|OPEN_VOTING|FINALIZE|CANCEL
  status       String   @default("PENDING") // PENDING|EXECUTED|FAILED|CANCELLED
  threshold    Int      // Distinct approvers required (>= 2)
  reason       String?

  // What every approver actually signs - domainHash(ELECTION-ADMIN-ACTION,
  // {electionId, action, reason, nonce}). Binding the nonce prevents a
  // signature collected for one proposal from being replayable against a
  // different proposal of the same action type.
  nonce        String
  proposalHash String

  proposedBy   String   // User id
  proposedByRole String
  createdAt    DateTime @default(now())

  executedAt   DateTime?
  executedBy   String?  // User id of the approver whose signature crossed the threshold
  executedResult String? // JSON snapshot of what happened (or the error, if FAILED)

  election     Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  signatures   ElectionApprovalSignature[]

  @@index([electionId])
  @@index([electionId, action, status])
  @@index([status])
}

// One distinct admin's cryptographic sign-off on a proposal. approverId is
// unique per approval - the same admin cannot count twice toward the
// threshold no matter how many times they call the approve endpoint.
model ElectionApprovalSignature {
  id              String   @id @default(uuid())
  approvalId      String

  approverId      String   // User id
  approverRole    String
  signerPublicKey String
  signature       String   // Ed25519 signature over the approval's proposalHash

  approvedAt      DateTime @default(now())

  approval        ElectionApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, approverId])
  @@index([approvalId])
}

// ============================================================================
// SECURITY & MONITORING
// ============================================================================

model AuditLog {
  id              String   @id @default(uuid())
  organizationId  String?
  
  // Actor
  actor           String   // User ID, SuperAdmin ID, or "SYSTEM"
  actorType       String   // USER|SUPER_ADMIN|SYSTEM|VOTER
  actorEmail      String?  // For correlation
  
  // Action
  action          String   // Specific action (CREATE_ELECTION, CAST_VOTE, etc)
  resource        String   // What was acted upon
  resourceId      String?  // ID of resource
  
  // Result
  result          String   // SUCCESS|FAILURE|ERROR|UNAUTHORIZED
  errorMessage    String?  // If failed
  
  // Context
  ipAddress       String?  // Hashed
  userAgent       String?  // Sanitized
  method          String?  // HTTP method
  path            String?  // API path
  requestBody     String?  // Sanitized request (no secrets)
  responseStatus  Int?     // HTTP status
  duration        Int?     // Request duration (ms)
  
  // Metadata
  details         String?  // JSON with additional context
  timestamp       DateTime @default(now())
  
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([timestamp])
  @@index([actor])
  @@index([action])
  @@index([result])
  @@index([actorType])
}

model SecurityEvent {
  id              String    @id @default(uuid())
  organizationId  String?
  
  // Event classification
  severity        String    // LOW|MEDIUM|HIGH|CRITICAL
  eventType       String    // BRUTE_FORCE|TIMING_ATTACK|INVALID_PROOF|DOUBLE_VOTE|IP_ANOMALY|etc
  category        String?   // AUTHENTICATION|AUTHORIZATION|ENCRYPTION|INTEGRITY|etc
  
  // Details
  details         String    // JSON with event specifics
  affectedResource String?  // What was targeted
  attackVector    String?   // How attack was attempted
  
  // Source
  ipAddress       String?   // Hashed
  userAgent       String?
  userId          String?
  
  // Response
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?   // SuperAdmin or User ID
  resolution      String?   // What was done
  falsePositive   Boolean   @default(false)
  
  timestamp       DateTime  @default(now())
  
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([timestamp])
  @@index([severity])
  @@index([eventType])
  @@index([resolved])
}

// ============================================================================
// METRICS & MONITORING (Level 12 Admin Dashboard)
// ============================================================================

model SystemMetric {
  id              String   @id @default(uuid())
  
  // Metric type
  metricType      String   // REQUEST_COUNT|ERROR_RATE|VOTE_LATENCY|CRYPTO_PERF|DB_QUERY_TIME
  metricName      String
  
  // Value
  value           Float
  unit            String   // ms, count, percentage, etc
  
  // Aggregation
  aggregation     String   // GAUGE|COUNTER|HISTOGRAM
  tags            String?  // JSON key-value pairs
  
  timestamp       DateTime @default(now())
  
  @@index([metricType])
  @@index([metricName])
  @@index([timestamp])
}

// ============================================================================
// WEBHOOKS & INTEGRATIONS
// ============================================================================

model Webhook {
  id              String    @id @default(uuid())
  organizationId  String
  
  // Config
  url             String
  events          String    // JSON array of event types
  secret          String    // HMAC secret for verification
  
  // Status
  enabled         Boolean   @default(true)
  failureCount    Int       @default(0)
  lastSuccess     DateTime?
  lastFailure     DateTime?
  lastError       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================================
// COMPLIANCE & CERTIFICATION
// ============================================================================

model ComplianceReport {
  id              String   @id @default(uuid())
  organizationId  String
  
  // Report type
  reportType      String   // SOC2|ISO27001|FIPS|AUDIT|PENTEST
  standard        String   // SOC 2 Type II, ISO 27001, etc
  
  // Results
  status          String   // PASS|FAIL|IN_PROGRESS|PENDING
  score           Float?   // 0-100
  findings        String   // JSON array of issues
  
  // Documents
  reportUrl       String?  // S3 link to PDF
  certificateUrl  String?
  
  // Dates
  auditStartDate  DateTime
  auditEndDate    DateTime?
  expiryDate      DateTime?
  
  // Auditor
  auditor         String?  // Company name
  auditorEmail    String?
  
  createdAt       DateTime @default(now())
  
  @@index([organizationId])
  @@index([reportType])
  @@index([status])
}

// ============================================================================
// REAL ELECTION DATA (Public Records - 2024 Presidential)
// ============================================================================

// US States with FIPS codes
model State {
  id              String   @id // FIPS code (e.g., "06" for California)
  name            String   @unique // "California"
  abbreviation    String   @unique // "CA"
  
  // Geographic (for map rendering)
  centerLat       Float?
  centerLng       Float?
  
  // 2024 Election totals (cached)
  totalVotes      Int      @default(0)
  votesGop        Int      @default(0)
  votesDem        Int      @default(0)
  votesOther      Int      @default(0)
  winner          String?  // "GOP" | "DEM"
  
  // Electoral votes
  electoralVotes  Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  counties        County[]
  
  @@index([name])
  @@index([abbreviation])
}

// US Counties with FIPS codes (3,100+ counties)
model County {
  id              String   @id // Full FIPS code (e.g., "06037" for LA County)
  stateId         String   // State FIPS (e.g., "06")
  name            String   // "Los Angeles County"
  
  // 2024 Presidential Results (REAL DATA)
  votesGop        Int      @default(0) // Trump
  votesDem        Int      @default(0) // Harris
  totalVotes      Int      @default(0)
  voteDiff        Int      @default(0) // GOP - DEM
  percentGop      Float    @default(0)
  percentDem      Float    @default(0)
  percentDiff     Float    @default(0)
  winner          String?  // "GOP" | "DEM"
  
  // Geographic (for map)
  centerLat       Float?
  centerLng       Float?
  
  // Reporting timeline (for election player)
  reportedAt      DateTime? // When this county reported
  reportOrder     Int?      // Order in which county reported
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  state           State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  
  @@unique([stateId, name])
  @@index([stateId])
  @@index([winner])
  @@index([reportOrder])
}

// National Election Summary (2024)
model NationalElection {
  id              String   @id @default(uuid())
  year            Int      @unique // 2024
  type            String   // "PRESIDENTIAL"
  
  // Candidates
  gopCandidate    String   // "Donald Trump"
  demCandidate    String   // "Kamala Harris"
  
  // National totals
  totalVotes      Int      @default(0)
  votesGop        Int      @default(0)
  votesDem        Int      @default(0)
  votesOther      Int      @default(0)
  
  // Electoral College
  electoralGop    Int      @default(0) // 312 for Trump
  electoralDem    Int      @default(0) // 226 for Harris
  electoralNeeded Int      @default(270)
  
  // Winner
  winner          String?  // "GOP" | "DEM"
  winnerName      String?  // "Donald Trump"
  
  // Data source
  dataSource      String?  // "tonmcg/US_County_Level_Election_Results_08-24"
  dataUrl         String?
  lastUpdated     DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([year])
}
