{
  "name": "trustless-voting-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "node -e \"console.log('Tests disabled for now. Run: npm run test:real');\"",
    "test:run": "node -e \"console.log('Tests disabled for now. Run: npm run test:run:real');\"",
    "test:coverage": "node -e \"console.log('Tests disabled for now. Run: npm run test:coverage:real');\"",
    "test:ui": "node -e \"console.log('Tests disabled for now. Run: npm run test:ui:real');\"",
    "test:real": "vitest",
    "test:run:real": "vitest run",
    "test:coverage:real": "vitest run --coverage",
    "test:ui:real": "vitest --ui"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^8.18.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/three": "^0.182.0",
    "axios": "^1.6.2",
    "d3-scale": "^4.0.2",
    "date-fns": "^3.0.6",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.21.1",
    "react-simple-maps": "^3.0.0",
    "react-toastify": "^9.1.3",
    "recharts": "^2.10.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^8.56.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.16"
  }
}
