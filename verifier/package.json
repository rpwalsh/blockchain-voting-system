{
  "name": "election-verifier",
  "version": "0.1.0",
  "description": "Independent CLI verifier for the election protocol's cryptographic integrity - does not trust or import the election server's code, only its public HTTP endpoints or an exported JSON bundle.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "election-verifier": "dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts"
  },
  "license": "PROPRIETARY",
  "dependencies": {
    "commander": "^12.1.0",
    "js-sha3": "^0.9.2",
    "opentimestamps": "^0.4.9",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
